@startuml
left to right direction
skinparam packageStyle rectangle
actor "Evcil Hayvan Sahibi" as Owner
actor "Veteriner" as Vet
actor "Sistem Yoneticisi" as Admin
actor "Bildirim Servisi" as Notify

rectangle "Veteriner Modulu" {
  usecase "Veteriner Arama" as UC1
  usecase "Musaitlik Goruntuleme" as UC2
  usecase "Randevu Talebi Olusturma" as UC3
  usecase "Randevu Onaylama/Reddetme" as UC4
  usecase "Randevu Hatirlatma" as UC5
  usecase "Randevu Gecmisi Izleme" as UC6
  usecase "Klinik Profilini Guncelleme" as UC7
  usecase "Yorum ve Puanlama Yapma" as UC8
}

Owner --> UC1
Owner --> UC2
Owner --> UC3
Owner --> UC6
Owner --> UC8
Vet --> UC4
Vet --> UC6
Vet --> UC7
Admin --> UC7
UC3 .> UC5 : <<include>>
UC4 .> UC5 : <<include>>
Notify --> UC5
@enduml
