@startuml
left to right direction
skinparam componentStyle rectangle

actor "Evcil Hayvan Sahibi" as User
actor "Veteriner" as Vet
actor "Pet Bakicisi" as Sitter
actor "Satici" as Seller
actor "Admin" as Admin

rectangle "Evcil Hayvan Hizmet Platformu" as System

cloud "Firebase FCM" as FCM
cloud "Google Places / Maps" as Maps
database "MongoDB Atlas" as DB
storage "Medya Depolama" as Storage

User --> System : pet, ilan, randevu, siparis, mesaj
Vet --> System : randevu ve klinik islemleri
Sitter --> System : bakici profili ve rezervasyon
Seller --> System : urun ve siparis yonetimi
Admin --> System : moderasyon ve raporlama

System --> FCM : bildirim
System --> Maps : konum ve arama
System --> DB : veri okuma/yazma
System --> Storage : fotograf/medya
@enduml
