@startuml
left to right direction
skinparam packageStyle rectangle

actor "Ziyaretçi" as Guest
actor "Kullanıcı" as User
actor "Veteriner" as Vet
actor "Pet Bakıcısı" as Sitter
actor "Satıcı" as Seller
actor "Admin" as Admin

rectangle "Evcil Hayvan Platformu" {
  usecase "Kayıt Ol" as UC1
  usecase "Giriş Yap" as UC2
  usecase "Pet Profili Yönet" as UC3
  usecase "Sahiplendirme İlanı Oluştur" as UC4
  usecase "Sahiplendirme Başvurusu Yap" as UC5
  usecase "Veteriner Ara" as UC6
  usecase "Randevu Oluştur" as UC7
  usecase "Aşı Kaydı Yönet" as UC8
  usecase "Bakıcı Bul" as UC9
  usecase "Bakıcı Rezervasyonu Yap" as UC10
  usecase "Mesajlaş" as UC11
  usecase "Sipariş Oluştur" as UC12
  usecase "Ürün Yönet" as UC13
  usecase "İçerik Denetle" as UC14
}

Guest --> UC1
Guest --> UC2

User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11
User --> UC12

Vet --> UC7
Vet --> UC8

Sitter --> UC10
Sitter --> UC11

Seller --> UC13

Admin --> UC14

UC7 .> UC6 : <<include>>
UC10 .> UC9 : <<include>>
UC12 .> UC11 : <<extend>>
