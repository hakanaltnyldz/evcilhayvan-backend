@startuml
left to right direction
skinparam packageStyle rectangle
actor "Evcil Hayvan Sahibi" as Owner
actor "Bakici" as Sitter
actor "Sistem Yoneticisi" as Admin
actor "Odeme Servisi" as Payment
actor "Bildirim Servisi" as Notify

rectangle "Bakici / Konaklama Modulu" {
  usecase "Bakici Arama" as UC1
  usecase "Bakici Profili Inceleme" as UC2
  usecase "Rezervasyon Talebi Olusturma" as UC3
  usecase "Talebi Onaylama/Reddetme" as UC4
  usecase "Odeme Onayi Alma" as UC5
  usecase "Hizmet Durumu Takibi" as UC6
  usecase "Hizmet Sonu Degerlendirme" as UC7
  usecase "Profil ve Musaitlik Yonetimi" as UC8
  usecase "Sikayet Degerlendirme" as UC9
}

Owner --> UC1
Owner --> UC2
Owner --> UC3
Owner --> UC6
Owner --> UC7
Sitter --> UC4
Sitter --> UC6
Sitter --> UC8
Admin --> UC9
UC3 .> UC5 : <<include>>
UC4 .> UC6 : <<include>>
Payment --> UC5
Notify --> UC3
Notify --> UC4
@enduml
